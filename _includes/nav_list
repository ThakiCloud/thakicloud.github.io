{% comment %}
  ⛔ 이 include 는 모든 페이지에 렌더된다. 안에서 site.posts 전수를 스캔하므로
  페이지당 비용 × 페이지 수 = O(n^2) 이고, 2026-08-13 기준 CI 빌드 1,352초의
  대부분이 여기서 나왔다(전체 1,520초의 89%가 Jekyll 빌드).
  sidebar.html 이 include_cached 로 부르므로 (lang, nav) 조합당 한 번만 렌더된다.
  ⛔ 그래서 page.* 를 직접 읽으면 안 된다 — 캐시된 첫 페이지 값이 전 페이지에 박힌다.
  언어는 반드시 include.lang 으로 받는다(아래 nl_lang). 새 조건을 추가할 때도 동일.

  ⛔ 2026-08-30: 여기 있던 태그 클라우드 블록을 삭제했다. HTML 주석(<!-- -->)으로
  꺼 놨지만 Jekyll 은 HTML 이 되기 전에 Liquid 를 먼저 돌린다 — 주석은 결과를
  브라우저에서만 가릴 뿐 루프를 막지 못한다. `(1..tags_max) x site.tags` =
  168 x 4,812 = 808,416 회 iteration 이 whitespace control 없이 돌면서 매번 개행을
  뱉었고, 그 결과 모든 글 페이지가 13.19 MB(공백 98.6%)로 나갔다. CloudFront 는
  10 MB 초과 객체를 압축하지 않으므로 gzip 도 걸리지 않았다(Fast 4G 기준 27.7초).
  삭제 후 55 KB / gzip 17.9 KB, 풀 빌드 34.1초 → 15.8초.
  ⛔ 루프를 다시 넣으려면 (a) 주석이 아니라 실제로 지우거나 조건부로 감싸고
     (b) 반드시 하이픈 붙은 Liquid 구분자(whitespace control)를 쓴다.
     태그 목록 자체는 _layouts/tags.html 소유.
  ⛔ 이 주석 안에 Liquid 태그 문법을 그대로 쓰지 마라 — comment 블록 안에서도
     토크나이즈되어 빌드가 죽는다(2026-08-30 실제로 한 번 죽였다).
{% endcomment %}
{% assign nl_lang = include.lang | default: page.lang %}
{% comment %} Original navigation assignment - now replaced with custom logic {% endcomment %}
{% comment %} {% assign navigation = site.data.navigation[include.nav] %} {% endcomment %}

{% comment %} Category/tag sidebar menu (the generic nav block above was dead
   code — its unmatched `-->` leaked into the sidebar — so it was removed). {% endcomment %}
<nav class="nav__list">
  <input id="ac-toc" name="accordion-toc" type="checkbox" />
  <label for="ac-toc">{{ site.data.ui-text[site.locale].menu_label | default: "Toggle Menu" }}</label>
  <ul class="nav__items" id="category_tag_menu">
      {% comment %} Filter posts by language for accurate counts {% endcomment %}
      {% if nl_lang %}
        {% assign filtered_posts = site.posts | where: "lang", nl_lang %}
        {% assign lang_prefix = site.baseurl | append: '/' | append: nl_lang %}
      {% else %}
        {% comment %} For Korean main site, filter by path containing _posts/ko/ {% endcomment %}
        {% assign filtered_posts = site.posts | where_exp: "post", "post.path contains '_posts/ko/'" %}
        {% assign lang_prefix = site.baseurl %}
      {% endif %}

      {% comment %} Calculate language-specific category counts {% endcomment %}
      {% assign lang_dev_count = 0 %}
      {% assign lang_owm_count = 0 %}
      {% assign lang_llmops_count = 0 %}
      {% assign lang_agentops_count = 0 %}
      {% assign lang_tutorials_count = 0 %}
      {% assign lang_careers_count = 0 %}
      {% assign lang_culture_count = 0 %}
      {% assign lang_news_count = 0 %}
      {% assign lang_research_count = 0 %}
      {% assign lang_datasets_count = 0 %}
      {% assign lang_comics_count = 0 %}

      {% for post in filtered_posts %}
        {% if post.categories contains 'dev' %}
          {% assign lang_dev_count = lang_dev_count | plus: 1 %}
        {% endif %}
        {% if post.categories contains 'owm' %}
          {% assign lang_owm_count = lang_owm_count | plus: 1 %}
        {% endif %}
        {% if post.categories contains 'llmops' %}
          {% assign lang_llmops_count = lang_llmops_count | plus: 1 %}
        {% endif %}
        {% if post.categories contains 'agentops' %}
          {% assign lang_agentops_count = lang_agentops_count | plus: 1 %}
        {% endif %}
        {% if post.categories contains 'tutorials' %}
          {% assign lang_tutorials_count = lang_tutorials_count | plus: 1 %}
        {% endif %}
        {% if post.categories contains 'careers' %}
          {% assign lang_careers_count = lang_careers_count | plus: 1 %}
        {% endif %}
        {% if post.categories contains 'culture' %}
          {% assign lang_culture_count = lang_culture_count | plus: 1 %}
        {% endif %}
        {% if post.categories contains 'news' %}
          {% assign lang_news_count = lang_news_count | plus: 1 %}
        {% endif %}
        {% if post.categories contains 'research' %}
          {% assign lang_research_count = lang_research_count | plus: 1 %}
        {% endif %}
        {% if post.categories contains 'datasets' %}
          {% assign lang_datasets_count = lang_datasets_count | plus: 1 %}
        {% endif %}
        {% if post.categories contains 'comics' %}
          {% assign lang_comics_count = lang_comics_count | plus: 1 %}
        {% endif %}
      {% endfor %}

      {% comment %} Every language uses the same category value, so no per-language mapping. {% endcomment %}
      {% assign comics_cat = 'comics' %}
      <li>
        <span class="nav__sub-title" v-on:click='togglec()'><a href="{{ lang_prefix }}/">📂 Total Posts: {{ filtered_posts.size }}</a></span>
      </li>
      <li>
        <span class="nav__sub-title" v-on:click='togglec()'><a href="{{ lang_prefix }}/?category=dev">🚀 DevOps ({{ lang_dev_count }})</a></span>
        <span class="nav__sub-title" v-on:click='togglec()'><a href="{{ lang_prefix }}/?category=owm">📀 OWM ({{ lang_owm_count }})</a></span>
        <span class="nav__sub-title" v-on:click='togglec()'><a href="{{ lang_prefix }}/?category=llmops">🤖 LLMOps ({{ lang_llmops_count }})</a></span>
        <span class="nav__sub-title" v-on:click='togglec()'><a href="{{ lang_prefix }}/?category=agentops">🏗️ AgentOps ({{ lang_agentops_count }})</a></span>
        <span class="nav__sub-title" v-on:click='togglec()'><a href="{{ lang_prefix }}/?category=tutorials">💻 Tutorials ({{ lang_tutorials_count }})</a></span>
        <span class="nav__sub-title" v-on:click='togglec()'><a href="{{ lang_prefix }}/?category=careers">🤝 Careers ({{ lang_careers_count }})</a></span>
        <span class="nav__sub-title" v-on:click='togglec()'><a href="{{ lang_prefix }}/?category=culture">🎨 Culture ({{ lang_culture_count }})</a></span>
        <span class="nav__sub-title" v-on:click='togglec()'><a href="{{ lang_prefix }}/?category=news">🌐 News ({{ lang_news_count }})</a></span>
        <span class="nav__sub-title" v-on:click='togglec()'><a href="{{ lang_prefix }}/?category=research">📒 Research ({{ lang_research_count }})</a></span>
        <span class="nav__sub-title" v-on:click='togglec()'><a href="{{ lang_prefix }}/?category=datasets">☁️ Datasets ({{ lang_datasets_count }})</a></span>
        <span class="nav__sub-title" v-on:click='togglec()'><a href="{{ lang_prefix }}/?category={{ comics_cat | uri_escape }}">💬 Comics ({{ lang_comics_count }})</a></span>

      </li>
  </ul>
</nav>